#!/bin/bash
set -euo pipefail
umask 077
cd /app
case "${1:?usage: production-import fetch|preview|publish|export|accept [arguments]}" in
  fetch|preview|publish)
    zforum_stage="$1"
    shift
    exec scripts/zforum import "$zforum_stage" --db /data/zforum.sqlite "$@"
    ;;
  export|accept)
    zforum_stage="$1"
    zforum_file="${2:?transfer file required}"
    [[ "$#" == 2 && "$zforum_file" =~ ^/data/transfers/[a-zA-Z0-9-]+\.json$ ]] || { echo 'Invalid transfer path' >&2; exit 1; }
    exec flock -n -E 75 work/import.lock node tools/import-transfer.mjs "$zforum_stage" "$zforum_file" /data/zforum.sqlite
    ;;
  *) echo 'Unsupported production import command' >&2; exit 1 ;;
esac
